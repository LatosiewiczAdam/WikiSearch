# Azure DevOps
AZURE_DEVOPS_PAT=your_pat_here
AZURE_DEVOPS_ORG=your_organization
AZURE_DEVOPS_PROJECT=your_project

# Ollama - wszystko lokalnie, dane nie wychodzą poza firmę
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text   # embeddingi (~274MB, CPU)
# OLLAMA_CHAT_MODEL=llama3.2:3b       # domyślny model chatu

# App
CHROMA_PERSIST_DIR=./chroma_db

# Opcjonalnie - tylko jeśli chcesz testować z Claude
# ANTHROPIC_API_KEY=your_key_here
